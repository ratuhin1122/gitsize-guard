{
  "description": "gitsize-guard: check git add/commit and large file writes for repository growth",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse-gitsize.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
